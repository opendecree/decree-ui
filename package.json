{
	"name": "decree-ui",
	"private": true,
	"version": "0.2.0-alpha.2",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome check src/",
		"format": "biome format --write src/",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"generate": "swagger2openapi openapi.json -o openapi3.json && openapi-typescript openapi3.json -o src/api/schema.d.ts",
		"screenshots": "tsx scripts/screenshots.ts",
		"screenshots:full": "bash scripts/take-screenshots.sh",
		"screenshots:rebuild": "bash scripts/take-screenshots.sh --rebuild",
		"test:e2e": "playwright test",
		"pre-commit": "biome check src/ && tsc -b --noEmit && vitest run && npm run build"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@tanstack/react-query": "^5.101.1",
		"openapi-fetch": "^0.17.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.18.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.9",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.13.0",
		"swagger2openapi": "^7.0.8",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.22.4",
		"typescript": "~5.9.3",
		"vite": "^8.1.0",
		"vitest": "^4.1.4"
	},
	"overrides": {
		"js-yaml": "^4.2.0"
	}
}
